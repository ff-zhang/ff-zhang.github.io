---
/**
 * One page section. The heading renders as a shell command (the `$` is added
 * in CSS) but is a real <h2>, so the document outline stays correct for
 * screen readers and search engines.
 */
interface Props {
  id: string;
  command: string;
}

const { id, command } = Astro.props;
---

<section class="section" id={id}>
  <h2 class="section__heading">{command}</h2>
  <div class="section__body">
    <slot />
  </div>
</section>
